# ================================================================
# PLAYSTATION 5 DIRECT STOCK BOT CONFIGURATION
# ================================================================

# 1. DISCORD WEBHOOK CONFIGURATION (Recommended & 100% Free)
# Paste your Discord Channel Webhook URL below:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Role to mention on in-stock alerts (Optional):
# Options: 'everyone', 'here', or a numeric Role ID (e.g. 123456789012345678)
DISCORD_NOTIFY_ROLE_ID=everyone

# Bot username displayed in Discord
DISCORD_BOT_USERNAME=PS5 Stock Alert Bot

# 2. MONITORING SETTINGS
# Check frequency in seconds when running continuously (e.g., 60 seconds)
CHECK_INTERVAL_SECONDS=60

# Product SKU code on PlayStation Direct (Default: PS5 Pro Console 2TB)
PRODUCT_CODE=1000050928
TARGET_URL=https://direct.playstation.com/en-us/buy-consoles/playstation5-pro-console-2-tb

# Cooldown between repeat notifications if product remains in stock (in minutes)
IN_STOCK_ALERT_COOLDOWN_MINUTES=30

# Sound beep on local machine when in stock
ENABLE_DESKTOP_SOUND=true

# 3. OPTIONAL ALTERNATIVE NOTIFICATIONS
# Telegram Bot (Optional):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy.sh Topic for free instant mobile push alerts without an account (Optional):
NTFY_TOPIC=
